# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments / lock-managed venv
.venv/

# Export output (never commit generated datasets)
/out/
/output/

# Agent-tool isolation worktrees (accumulate, never commit)
.claude/worktrees/

# Local QA scratch / demo bundles (not part of the package; large, leaky).
# Anchored to repo root so tracked tools/qa/ (checkers) and docs/qa/ (reports)
# are NOT swept up; only the top-level scratch dir is ignored.
/qa/

# Materialized demo emit (rebuilt on demand by `make demo-emit`)
/dev/demo/emit/

# data bundles (Should be added to release)
docs/examples/*/bundle/

# published example emits: the binary ships via release artifacts, never git
# (finding: ship-real-producer-datasets-outside-git); the small text sidecar
# and atlas are committed beside it
docs/examples/*/published/run.duckdb

# per-example export/stream output (tools/run_all_exports.sh) — generated
# datasets, never committed
docs/examples/*/exports/
