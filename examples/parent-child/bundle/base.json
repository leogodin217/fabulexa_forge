          "description": "The child record. Joins exactly one group at creation via the immutable group reference \u2014 or none at all, for the rare group-less arrivals. Its projected email borrows the joined group's domain.",
          "value": "member"
        }
      ]
    },
    "entity": {
      "entity_type": [
        {
          "description": "The parent record. Carries no mechanism traits \u2014 it exists to be referenced; its rendered name and email domain are minted at presentation time and shared with every member that joins it.",
          "value": "group"
        }
      ]
    },
    "journey_instance": {
      "current_state": [
        {
          "description": "Terminal landing state; the member stays active.",
          "value": "joined"
        }
      ],
      "journey_type": [
        {
          "description": "Bookkeeping journey \u2014 every arrival lands in a single terminal state. Membership itself is assigned at creation by the arrival stream, not by journey behavior.",
